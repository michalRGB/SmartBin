        "z": "578295f7d4524e8b",
        "name": "estado",
        "func": "let safety = flow.get(\"lastSafety\") || {};\nlet filling = flow.get(\"lastFilling\") || {};\n\nmsg.payload = {\n    chatId: msg.payload.chatId,\n    type: \"message\",\n    content:\n        \"📊 ESTADO SMARTBIN\\n\\n\" +\n        \"Contenedor: \" + (safety.bin_id || filling.bin_id || \"N/A\") + \"\\n\" +\n        \"Estado: \" + (safety.status || \"N/A\") + \"\\n\" +\n        \"Temperatura: \" + (safety.temperature || \"N/A\") + \" °C\\n\" +\n        \"Humedad: \" + (safety.humidity || \"N/A\") + \" %\\n\" +\n        \"Llenado: \" + (filling.fill_percent || \"N/A\") + \" %\\n\" +\n        \"Nivel: \" + (filling.fill_level || \"N/A\") + \"\\n\" +\n        \"Aperturas: \" + (filling.open_count || \"N/A\")\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
